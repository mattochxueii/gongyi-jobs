---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  loadSiteData,
  PUBLIC_DEFAULT_TREATMENT_LABEL,
} from '../lib/data';
import type { BianzhiType, EducationLevel } from '../lib/types';

const data = loadSiteData();
const publicJobs = data.jobs.filter((j) => j.category === 'public_institution');
const activePublicCount = publicJobs.filter((j) => j.status === 'active').length;

const EDU_OPTIONS: EducationLevel[] = [
  '不限',
  '中专/高中',
  '大专',
  '本科',
  '硕士',
  '博士',
  '见公告',
];

const BIANZHI_OPTIONS: BianzhiType[] = [
  '全额拨款事业编',
  '差额补贴事业编',
  '自收自支事业编',
  '控制数/备案制',
  '公开招聘(具体见公告)',
  '未知',
];

const citySet = new Set<string>();
for (const job of publicJobs) {
  if (job.city) citySet.add(job.city);
}
const availableCities = Array.from(citySet).sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout
  title="河南省事业编公开招考专区 · 豫聘公益导航"
  description="河南省事业编及体制内公开招考岗位汇总：支持城市、最低学历、编制类型、是否限应届与关键字多维实时筛选，显性标注事业单位工资标准与补贴提示，高亮报名截止倒计时并直达官方原文与附件。"
  activeNav="public"
  isPreviewFixtures={data.isPreviewFixtures}
  latestUpdatedAt={data.latestUpdatedAt}
>
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 sm:py-9">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-teal-50 text-teal-800 border border-teal-200 text-xs font-medium mb-2">
            首期试点：河南省 · 静态分片极速检索
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            事业编 / 公开招考专区
          </h1>
          <p class="mt-1.5 text-sm text-slate-600">
            纯前端实时多维筛选与分页（每页 20 条） · 统一标注<strong class="font-semibold text-slate-800">「{PUBLIC_DEFAULT_TREATMENT_LABEL}」</strong>并自动提取公告待遇提示。
          </p>
        </div>
        <div class="text-xs sm:text-sm text-slate-600 bg-slate-50 px-3.5 py-2 rounded-lg border border-slate-200 tabular-nums shrink-0">
          当前库内共 <strong id="public-total-count" class="text-slate-900">{publicJobs.length}</strong> 条事业编记录（在招 <strong class="text-teal-800">{activePublicCount}</strong> 条）
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 space-y-6">
    <section
      aria-label="多维筛选面板"
      class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-xs space-y-4"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="sm:col-span-2 lg:col-span-2">
          <label for="filter-q" class="block text-xs font-medium text-slate-600 mb-1">
            关键字 / 专业 / 单位
          </label>
          <input
            id="filter-q"
            type="search"
            placeholder="例如：计算机、会计、省直、郑州市、博士、补贴..."
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          />
        </div>

        <div>
          <label for="filter-city" class="block text-xs font-medium text-slate-600 mb-1">
            招录城市
          </label>
          <select
            id="filter-city"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部城市</option>
            {availableCities.map((city) => <option value={city}>{city}</option>)}
          </select>
        </div>

        <div>
          <label for="filter-edu" class="block text-xs font-medium text-slate-600 mb-1">
            最低学历要求
          </label>
          <select
            id="filter-edu"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部学历</option>
            {EDU_OPTIONS.map((edu) => <option value={edu}>{edu}</option>)}
          </select>
        </div>

        <div>
          <label for="filter-bianzhi" class="block text-xs font-medium text-slate-600 mb-1">
            编制类型
          </label>
          <select
            id="filter-bianzhi"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部编制类型</option>
            {BIANZHI_OPTIONS.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-slate-100">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2">
            <label for="filter-fresh" class="text-xs font-medium text-slate-600 shrink-0">
              应届要求：
            </label>
            <select
              id="filter-fresh"
              class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
            >
              <option value="">全部（不限）</option>
              <option value="true">仅限应届生</option>
              <option value="false">非仅限应届（含往届可报）</option>
              <option value="unknown">未标注 / 见公告</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <label for="filter-sort" class="text-xs font-medium text-slate-600 shrink-0">
              排序：
            </label>
            <select
              id="filter-sort"
              class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
            >
              <option value="deadline">临近截止优先</option>
              <option value="published">最新发布优先</option>
            </select>
          </div>

          <label class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-slate-700 cursor-pointer select-none">
            <input
              id="filter-hide-expired"
              type="checkbox"
              class="rounded border-slate-300 text-teal-700 focus:ring-teal-600"
            />
            <span>仅看未截止岗位</span>
          </label>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-3 text-xs sm:text-sm">
          <span class="text-slate-600 tabular-nums">
            匹配岗位：<strong id="public-match-count" class="text-slate-900">{publicJobs.length}</strong> 条
          </span>
          <button
            id="public-reset-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 text-xs font-medium transition-colors cursor-pointer"
          >
            重置筛选
          </button>
        </div>
      </div>
    </section>

    {
      publicJobs.length === 0 ? (
        <section
          id="public-init-empty"
          class="bg-white rounded-xl border border-slate-200 p-8 sm:p-12 text-center space-y-3"
        >
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-500 mx-auto">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-slate-900">
            数据初始化中 · 暂无事业编公开招考岗位
          </h2>
          <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
            当前 <code class="px-1 py-0.5 rounded bg-slate-100 text-xs">data/jobs.json</code> 中暂未收录事业编记录。待河南人社厅及各地市官网增量采集入库后，岗位信息与附件将自动展示在此页面。
          </p>
          <div class="pt-2 flex flex-wrap justify-center gap-3">
            <a
              href="/about"
              class="px-4 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-sm font-medium transition-colors"
            >
              查看采集与纠错说明
            </a>
            <a
              href="/companies"
              class="px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium transition-colors"
            >
              浏览高福利民企专区
            </a>
          </div>
        </section>
      ) : (
        <>
          <div
            id="public-loading-state"
            class="bg-white rounded-xl border border-slate-200 p-8 text-center text-sm text-slate-500"
          >
            正在加载事业编招考静态数据索引（共 {publicJobs.length} 条记录，覆盖 {availableCities.join('、') || '河南省'}）…
          </div>

          <div id="public-jobs-list" class="space-y-4"></div>

          <nav
            id="public-pagination"
            aria-label="事业编岗位分页导航"
            class="hidden bg-white rounded-xl border border-slate-200 p-4 shadow-xs"
          ></nav>

          <section
            id="public-empty-filter"
            class="hidden bg-white rounded-xl border border-slate-200 p-8 sm:p-10 text-center space-y-3"
          >
            <h2 class="text-base sm:text-lg font-semibold text-slate-900">
              暂无匹配岗位
            </h2>
            <p class="text-sm text-slate-600">
              当前筛选条件下没有找到符合条件的事业编公开招考岗位，建议放宽关键字、学历或应届生限制后重试。
            </p>
            <div>
              <button
                id="public-empty-reset-btn"
                type="button"
                class="px-4 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-sm font-medium transition-colors cursor-pointer"
              >
                清空所有筛选条件
              </button>
            </div>
          </section>
        </>
      )
    }
  </div>

  <script is:inline>
    (function () {
      var listEl = document.getElementById('public-jobs-list');
      if (!listEl) return;

      var PAGE_SIZE = 20;
      var TREATMENT_LABEL = '待遇：执行国家/省事业单位工资标准（补贴见公告）';
      var SOURCE_TYPE_LABELS = {
        gov_official: '政务官网',
        institution_official: '事业单位官网',
        company_official: '企业官网',
        verified_saas: '官方招聘SaaS',
      };

      var loadingEl = document.getElementById('public-loading-state');
      var paginationEl = document.getElementById('public-pagination');
      var emptyFilterEl = document.getElementById('public-empty-filter');
      var countEl = document.getElementById('public-match-count');
      var totalCountEl = document.getElementById('public-total-count');

      var qInput = document.getElementById('filter-q');
      var citySelect = document.getElementById('filter-city');
      var eduSelect = document.getElementById('filter-edu');
      var bianzhiSelect = document.getElementById('filter-bianzhi');
      var freshSelect = document.getElementById('filter-fresh');
      var sortSelect = document.getElementById('filter-sort');
      var hideExpiredCheck = document.getElementById('filter-hide-expired');
      var resetBtn = document.getElementById('public-reset-btn');
      var emptyResetBtn = document.getElementById('public-empty-reset-btn');

      var allJobs = [];
      var filteredJobs = [];
      var currentPage = 1;

      var beijingToday = new Date(Date.now() + 8 * 3600000).toISOString().slice(0, 10);
      var todayParts = beijingToday.split('-').map(Number);
      var todayUtc = Date.UTC(todayParts[0], todayParts[1] - 1, todayParts[2]);

      function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
      }

      function safeHttpUrl(rawUrl) {
        if (!rawUrl || typeof rawUrl !== 'string') return null;
        var trimmed = rawUrl.trim();
        try {
          var parsed = new URL(trimmed, window.location.origin);
          if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
            return parsed.href;
          }
        } catch (e) {}
        return null;
      }

      function computeDeadline(deadlineAt, status) {
        if (status === 'expired' || status === 'closed') {
          return {
            isExpired: true,
            label: status === 'closed' ? '已关闭' : '已截止',
            badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-slate-100 text-slate-500 border-slate-200',
          };
        }
        if (deadlineAt && /^\d{4}-\d{2}-\d{2}$/.test(deadlineAt)) {
          var p = deadlineAt.split('-').map(Number);
          var diff = Math.round((Date.UTC(p[0], p[1] - 1, p[2]) - todayUtc) / 86400000);
          if (diff < 0) {
            return {
              isExpired: true,
              label: '已截止',
              badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-slate-100 text-slate-500 border-slate-200',
            };
          }
          if (diff === 0) {
            return {
              isExpired: false,
              label: '今日截止',
              badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-rose-50 text-rose-700 border-rose-200 font-semibold',
            };
          }
          if (diff <= 3) {
            return {
              isExpired: false,
              label: '剩 ' + diff + ' 天',
              badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-amber-50 text-amber-800 border-amber-200 font-semibold',
            };
          }
          return {
            isExpired: false,
            label: '剩 ' + diff + ' 天',
            badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-emerald-50 text-emerald-700 border-emerald-200',
          };
        }
        return {
          isExpired: false,
          label: '截止时间见公告',
          badgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs sm:text-sm border tabular-nums bg-slate-50 text-slate-700 border-slate-200',
        };
      }

      function extractSalaryHintClient(summary, otherReqs) {
        var combined = [summary || '', otherReqs || ''].filter(Boolean).join('。');
        if (!combined) return null;
        var clauses = combined.split(/[。；;\n]+/);
        var kw = /(年薪|月薪|安家费|科研启动费?|购房补贴|住房补贴|生活补贴|人才补贴|津贴|补贴|工资待遇|薪酬待遇|福利待遇|待遇详见|待遇按|待遇标准)/;
        for (var i = 0; i < clauses.length; i++) {
          var c = clauses[i].trim();
          if (!c) continue;
          var cleaned = c.replace(/差额补贴/g, '');
          if (kw.test(cleaned)) {
            return c.length > 96 ? c.slice(0, 96) + '…' : c;
          }
        }
        return null;
      }

      function getFreshCode(val) {
        if (val === true) return 'true';
        if (val === false) return 'false';
        return 'unknown';
      }

      function getFreshLabel(val) {
        if (val === true) return '仅限应届生';
        if (val === false) return '不限应届（含往届可报）';
        return '应届要求见公告';
      }

      function buildSearchString(job) {
        var pm = job.public_meta || {};
        var parts = [
          job.title || '',
          job.org_name || '',
          job.province || '',
          job.city || '',
          job.district || '',
          job.summary || '',
          job.source_name || '',
          job.salary_hint || '',
          (job.tags || []).join(' '),
          pm.post_code || '',
          pm.department || '',
          pm.post_level || '',
          pm.bianzhi_type || '',
          pm.education_min || '',
          pm.degree_min || '',
          pm.announcement_title || '',
          pm.exam_type || '',
          pm.apply_method || '',
          pm.other_requirements || '',
          (pm.majors || []).join(' '),
        ];
        return parts.join(' ').toLowerCase();
      }

      function renderPublicCard(job) {
        var pm = job.public_meta || {};
        var dl = job._dl;
        var article = el(
          'article',
          'bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-xs hover:border-slate-300 transition-colors'
        );

        // Top row
        var topRow = el('div', 'flex flex-col sm:flex-row sm:items-start justify-between gap-3');
        var leftCol = el('div', 'space-y-2 min-w-0');
        var badgeRow = el('div', 'flex flex-wrap items-center gap-1.5 text-xs');

        var cityText = job.city + (job.district ? ' · ' + job.district : '');
        badgeRow.appendChild(el('span', 'px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-medium', cityText));
        badgeRow.appendChild(
          el(
            'span',
            'px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200 font-medium',
            pm.bianzhi_type || '公开招聘(具体见公告)'
          )
        );

        var eduText = (pm.education_min || '见公告') + (pm.degree_min ? ' (' + pm.degree_min + ')' : '');
        badgeRow.appendChild(
          el('span', 'px-2 py-0.5 rounded bg-sky-50 text-sky-800 border border-sky-200 font-medium', eduText)
        );

        var freshClass =
          pm.fresh_grad_only === true
            ? 'px-2 py-0.5 rounded border font-medium bg-violet-50 text-violet-800 border-violet-200'
            : 'px-2 py-0.5 rounded border font-medium bg-slate-50 text-slate-600 border-slate-200';
        badgeRow.appendChild(el('span', freshClass, getFreshLabel(pm.fresh_grad_only)));

        if (pm.headcount) {
          badgeRow.appendChild(
            el(
              'span',
              'px-2 py-0.5 rounded bg-amber-50/70 text-amber-900 border border-amber-200/80 font-medium tabular-nums',
              '招 ' + pm.headcount + ' 人'
            )
          );
        }
        if (pm.post_code) {
          badgeRow.appendChild(
            el('span', 'px-2 py-0.5 rounded bg-slate-50 text-slate-500 border border-slate-200 font-mono', '岗码 ' + pm.post_code)
          );
        }
        leftCol.appendChild(badgeRow);

        // Title and org block
        var titleBlock = el('div', '');
        titleBlock.appendChild(el('h2', 'text-lg sm:text-xl font-bold text-slate-900 leading-snug', job.title));

        var orgRow = el('div', 'mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-slate-700');
        orgRow.appendChild(el('span', 'font-medium', job.org_name));
        if (pm.department) {
          orgRow.appendChild(el('span', 'text-slate-500', '· ' + pm.department));
        }
        if (pm.post_level) {
          orgRow.appendChild(el('span', 'text-slate-500', '· ' + pm.post_level));
        }
        titleBlock.appendChild(orgRow);

        if (pm.announcement_title) {
          titleBlock.appendChild(el('p', 'mt-1 text-xs text-slate-500', '所属公告：' + pm.announcement_title));
        }
        leftCol.appendChild(titleBlock);

        // Explicit Treatment & Salary Hint Row
        var treatmentWrap = el('div', 'pt-0.5 space-y-1.5');
        var treatmentRow = el('div', 'flex flex-wrap items-center gap-2');
        treatmentRow.appendChild(
          el(
            'span',
            'inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-teal-50/90 text-teal-900 border border-teal-200 text-xs font-semibold',
            '💼 ' + TREATMENT_LABEL
          )
        );
        treatmentWrap.appendChild(treatmentRow);

        var salaryHint = job.salary_hint || extractSalaryHintClient(job.summary, pm.other_requirements);
        if (salaryHint) {
          treatmentWrap.appendChild(
            el(
              'div',
              'px-3 py-1.5 rounded-lg bg-amber-50/90 border border-amber-200 text-xs text-amber-950 font-medium',
              '💡 待遇/补贴提取：' + salaryHint
            )
          );
        }
        leftCol.appendChild(treatmentWrap);
        topRow.appendChild(leftCol);

        // Right deadline column
        var rightCol = el('div', 'flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0');
        var dlBadge = el('span', dl.badgeClass);
        dlBadge.appendChild(el('span', 'font-normal text-xs opacity-80', '报名截止：'));
        dlBadge.appendChild(el('span', 'font-semibold', dl.label));
        rightCol.appendChild(dlBadge);
        if (job.published_at) {
          rightCol.appendChild(el('span', 'text-xs text-slate-400 tabular-nums', '发布：' + job.published_at));
        }
        topRow.appendChild(rightCol);
        article.appendChild(topRow);

        // Summary
        article.appendChild(el('p', 'mt-3 text-sm text-slate-700 leading-relaxed', job.summary));

        // 4-cell schedule grid
        var grid = el('div', 'mt-4 grid grid-cols-2 lg:grid-cols-4 gap-2.5 bg-slate-50 rounded-lg border border-slate-200/80 p-3 text-xs');
        var cells = [
          { label: '报名开始', val: pm.apply_start_at || '详见公告', strong: false },
          { label: '报名截止', val: job.deadline_at || '详见公告', strong: true },
          { label: '笔试时间', val: pm.written_exam_time || '详见公告', strong: false },
          { label: '面试时间', val: pm.interview_time || '详见公告', strong: false },
        ];
        cells.forEach(function (c) {
          var cell = el('div', '');
          cell.appendChild(el('div', 'text-slate-400', c.label));
          cell.appendChild(
            el('div', c.strong ? 'mt-0.5 font-medium text-slate-900 tabular-nums' : 'mt-0.5 font-medium text-slate-800 tabular-nums', c.val)
          );
          grid.appendChild(cell);
        });
        article.appendChild(grid);

        // Majors & conditions
        var metaRow = el('div', 'mt-3.5 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-600');
        var majorsWrap = el('div', 'flex flex-wrap items-center gap-1.5');
        majorsWrap.appendChild(el('span', 'text-slate-400 shrink-0', '专业要求：'));
        var majors = Array.isArray(pm.majors) ? pm.majors : [];
        if (majors.length > 0) {
          majors.forEach(function (m) {
            majorsWrap.appendChild(el('span', 'px-2 py-0.5 rounded bg-slate-100 text-slate-700', m));
          });
        } else {
          majorsWrap.appendChild(el('span', 'text-slate-500', '详见官方公告及职位表'));
        }
        metaRow.appendChild(majorsWrap);

        var condWrap = el('div', 'flex flex-wrap items-center gap-x-4 gap-y-1 md:justify-end');
        if (pm.age_limit) {
          var ageSpan = el('span', '');
          ageSpan.appendChild(el('span', 'text-slate-400', '年龄：'));
          ageSpan.appendChild(document.createTextNode(pm.age_limit));
          condWrap.appendChild(ageSpan);
        }
        if (pm.political_status) {
          var polSpan = el('span', '');
          polSpan.appendChild(el('span', 'text-slate-400', '政治面貌：'));
          polSpan.appendChild(document.createTextNode(pm.political_status));
          condWrap.appendChild(polSpan);
        }
        if (pm.exam_type) {
          var examSpan = el('span', '');
          examSpan.appendChild(el('span', 'text-slate-400', '考核：'));
          examSpan.appendChild(document.createTextNode(pm.exam_type));
          condWrap.appendChild(examSpan);
        }
        metaRow.appendChild(condWrap);
        article.appendChild(metaRow);

        if (pm.apply_method || pm.other_requirements) {
          var extraWrap = el('div', 'mt-2.5 text-xs text-slate-600 space-y-1');
          if (pm.apply_method) {
            var amDiv = el('div', '');
            amDiv.appendChild(el('span', 'text-slate-400', '报名方式：'));
            amDiv.appendChild(document.createTextNode(pm.apply_method));
            extraWrap.appendChild(amDiv);
          }
          if (pm.other_requirements) {
            var orDiv = el('div', '');
            orDiv.appendChild(el('span', 'text-slate-400', '其他条件：'));
            orDiv.appendChild(document.createTextNode(pm.other_requirements));
            extraWrap.appendChild(orDiv);
          }
          article.appendChild(extraWrap);
        }

        // Attachments
        var attachments = Array.isArray(pm.attachments) ? pm.attachments : [];
        if (attachments.length > 0) {
          var attSection = el('div', 'mt-4 pt-3 border-t border-slate-100');
          attSection.appendChild(
            el('div', 'text-xs font-medium text-slate-500 mb-2', '官方公告附件直达（' + attachments.length + '）')
          );
          var attList = el('ul', 'flex flex-wrap gap-2');
          attachments.forEach(function (att) {
            var validAttUrl = safeHttpUrl(att.url);
            if (!validAttUrl) return;
            var li = el('li', '');
            var a = el(
              'a',
              'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-50 hover:bg-teal-50 border border-slate-200 hover:border-teal-300 text-xs text-slate-700 hover:text-teal-800 transition-colors'
            );
            a.setAttribute('href', validAttUrl);
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
            if (att.file_type) {
              a.appendChild(
                el(
                  'span',
                  'px-1.5 py-0.5 rounded bg-white border border-slate-200 font-mono text-[10px] uppercase text-slate-500',
                  att.file_type
                )
              );
            }
            a.appendChild(el('span', 'break-all', att.name));
            a.appendChild(el('span', '', '↗'));
            li.appendChild(a);
            attList.appendChild(li);
          });
          attSection.appendChild(attList);
          article.appendChild(attSection);
        }

        // Footer links
        var footer = el('div', 'mt-4 pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3');
        var sourceLabel = SOURCE_TYPE_LABELS[job.source_type] || '官方渠道';
        footer.appendChild(el('div', 'text-xs text-slate-500', '来源：' + job.source_name + '（' + sourceLabel + '）'));

        var btnGroup = el('div', 'flex flex-wrap items-center gap-2');
        var validApplyUrl = safeHttpUrl(job.apply_url);
        if (validApplyUrl) {
          var applyLink = el(
            'a',
            'inline-flex items-center gap-1 px-3.5 py-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-xs font-medium transition-colors',
            '官方报名入口 ↗'
          );
          applyLink.setAttribute('href', validApplyUrl);
          applyLink.setAttribute('target', '_blank');
          applyLink.setAttribute('rel', 'noopener noreferrer');
          btnGroup.appendChild(applyLink);
        }

        var validSourceUrl = safeHttpUrl(job.source_url);
        if (validSourceUrl) {
          var sourceLink = el(
            'a',
            'inline-flex items-center gap-1 px-3.5 py-1.5 rounded-lg border border-teal-700/30 bg-teal-50/70 hover:bg-teal-100/70 text-teal-800 text-xs font-medium transition-colors',
            '官方公告原文 ↗'
          );
          sourceLink.setAttribute('href', validSourceUrl);
          sourceLink.setAttribute('target', '_blank');
          sourceLink.setAttribute('rel', 'noopener noreferrer');
          btnGroup.appendChild(sourceLink);
        }
        footer.appendChild(btnGroup);
        article.appendChild(footer);

        return article;
      }

      function renderPagination(totalItems) {
        if (!paginationEl) return;
        paginationEl.replaceChildren();
        var totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        if (totalItems === 0) {
          paginationEl.classList.add('hidden');
          return;
        }
        paginationEl.classList.remove('hidden');

        var wrap = el('div', 'flex flex-col sm:flex-row items-center justify-between gap-3 text-xs sm:text-sm');
        var info = el(
          'div',
          'text-slate-600 tabular-nums',
          '共 ' + totalItems + ' 条岗位 · 第 ' + currentPage + ' / ' + totalPages + ' 页（每页 ' + PAGE_SIZE + ' 条）'
        );
        wrap.appendChild(info);

        var controls = el('div', 'flex flex-wrap items-center gap-2');

        var prevBtn = el(
          'button',
          currentPage > 1
            ? 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors cursor-pointer'
            : 'px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-400 font-medium cursor-not-allowed',
          '上一页'
        );
        prevBtn.type = 'button';
        prevBtn.disabled = currentPage <= 1;
        prevBtn.addEventListener('click', function () {
          if (currentPage > 1) {
            currentPage--;
            renderCurrentPage(true);
          }
        });
        controls.appendChild(prevBtn);

        var nextBtn = el(
          'button',
          currentPage < totalPages
            ? 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors cursor-pointer'
            : 'px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-400 font-medium cursor-not-allowed',
          '下一页'
        );
        nextBtn.type = 'button';
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.addEventListener('click', function () {
          if (currentPage < totalPages) {
            currentPage++;
            renderCurrentPage(true);
          }
        });
        controls.appendChild(nextBtn);

        // Jump to page
        var jumpWrap = el('div', 'flex items-center gap-1.5 ml-1');
        jumpWrap.appendChild(el('span', 'text-slate-500 text-xs', '跳至'));
        var jumpInput = el(
          'input',
          'w-14 px-2 py-1 text-center bg-slate-50 border border-slate-200 rounded-md text-xs text-slate-800 tabular-nums focus:outline-none focus:border-teal-600'
        );
        jumpInput.type = 'number';
        jumpInput.min = '1';
        jumpInput.max = String(totalPages);
        jumpInput.value = String(currentPage);
        jumpInput.setAttribute('aria-label', '跳转页码');
        jumpWrap.appendChild(jumpInput);
        jumpWrap.appendChild(el('span', 'text-slate-500 text-xs', '页'));

        var jumpBtn = el(
          'button',
          'px-2.5 py-1 rounded-md bg-teal-700 hover:bg-teal-800 text-white text-xs font-medium transition-colors cursor-pointer',
          '跳转'
        );
        jumpBtn.type = 'button';
        function doJump() {
          var targetPage = parseInt(jumpInput.value, 10);
          if (!isNaN(targetPage)) {
            targetPage = Math.max(1, Math.min(totalPages, targetPage));
            if (targetPage !== currentPage) {
              currentPage = targetPage;
              renderCurrentPage(true);
            }
          }
        }
        jumpBtn.addEventListener('click', doJump);
        jumpInput.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter') {
            ev.preventDefault();
            doJump();
          }
        });
        jumpWrap.appendChild(jumpBtn);
        controls.appendChild(jumpWrap);

        wrap.appendChild(controls);
        paginationEl.appendChild(wrap);
      }

      function renderCurrentPage(scrollToTop) {
        listEl.replaceChildren();
        var total = filteredJobs.length;
        var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        var start = (currentPage - 1) * PAGE_SIZE;
        var pageItems = filteredJobs.slice(start, start + PAGE_SIZE);

        var frag = document.createDocumentFragment();
        pageItems.forEach(function (job) {
          frag.appendChild(renderPublicCard(job));
        });
        listEl.appendChild(frag);

        if (countEl) countEl.textContent = String(total);
        if (emptyFilterEl) {
          emptyFilterEl.classList.toggle('hidden', total > 0);
        }
        renderPagination(total);

        if (scrollToTop && listEl.getBoundingClientRect().top < 0) {
          listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function applyFiltersAndSort() {
        var q = (qInput && qInput.value ? qInput.value : '').trim().toLowerCase();
        var terms = q ? q.split(/\s+/).filter(Boolean) : [];
        var city = citySelect ? citySelect.value : '';
        var edu = eduSelect ? eduSelect.value : '';
        var bianzhi = bianzhiSelect ? bianzhiSelect.value : '';
        var fresh = freshSelect ? freshSelect.value : '';
        var hideExpired = hideExpiredCheck ? hideExpiredCheck.checked : false;
        var sortMode = sortSelect ? sortSelect.value : 'deadline';

        filteredJobs = allJobs.filter(function (job) {
          var pm = job.public_meta || {};
          if (city && job.city !== city) return false;
          if (edu && (pm.education_min || '见公告') !== edu) return false;
          if (bianzhi && (pm.bianzhi_type || '未知') !== bianzhi) return false;
          if (fresh && job._freshCode !== fresh) return false;
          if (hideExpired && job._dl.isExpired) return false;
          if (terms.length > 0) {
            for (var i = 0; i < terms.length; i++) {
              if (job._search.indexOf(terms[i]) === -1) return false;
            }
          }
          return true;
        });

        filteredJobs.sort(function (a, b) {
          if (sortMode === 'published') {
            return (b.published_at || '').localeCompare(a.published_at || '');
          }
          var ea = a._dl.isExpired ? 1 : 0;
          var eb = b._dl.isExpired ? 1 : 0;
          if (ea !== eb) return ea - eb;
          var da = a.deadline_at || '9999-12-31';
          var db = b.deadline_at || '9999-12-31';
          if (da !== db) return da.localeCompare(db);
          return (b.published_at || '').localeCompare(a.published_at || '');
        });

        currentPage = 1;
        renderCurrentPage(false);
      }

      function resetAll() {
        if (qInput) qInput.value = '';
        if (citySelect) citySelect.value = '';
        if (eduSelect) eduSelect.value = '';
        if (bianzhiSelect) bianzhiSelect.value = '';
        if (freshSelect) freshSelect.value = '';
        if (hideExpiredCheck) hideExpiredCheck.checked = false;
        if (sortSelect) sortSelect.value = 'deadline';
        applyFiltersAndSort();
      }

      try {
        var params = new URLSearchParams(window.location.search);
        var initQ = params.get('q');
        var initCity = params.get('city');
        if (initQ && qInput) qInput.value = initQ;
        if (initCity && citySelect) citySelect.value = initCity;
      } catch (e) {}

      [qInput, citySelect, eduSelect, bianzhiSelect, freshSelect, hideExpiredCheck, sortSelect].forEach(
        function (ctrl) {
          if (!ctrl) return;
          ctrl.addEventListener('input', applyFiltersAndSort);
          ctrl.addEventListener('change', applyFiltersAndSort);
        }
      );

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

      fetch('/api/jobs.json')
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (payload) {
          if (loadingEl) loadingEl.classList.add('hidden');
          var rawPublic = Array.isArray(payload.public_jobs) ? payload.public_jobs : [];
          allJobs = rawPublic.map(function (job) {
            var pm = job.public_meta || {};
            job._dl = computeDeadline(job.deadline_at, job.status);
            job._freshCode = getFreshCode(pm.fresh_grad_only);
            job._search = buildSearchString(job);
            return job;
          });
          if (totalCountEl) totalCountEl.textContent = String(allJobs.length);
          applyFiltersAndSort();
        })
        .catch(function () {
          if (loadingEl) {
            loadingEl.textContent = '加载静态数据索引失败，请刷新页面重试。';
          }
        });
    })();
  </script>
</BaseLayout>
