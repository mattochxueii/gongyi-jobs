      function renderPagination(totalItems, unitLabel) {
        if (!paginationEl) return;
        paginationEl.replaceChildren();
        var totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
        if (totalItems === 0) {
          paginationEl.classList.add('hidden');
          return;
        }
        paginationEl.classList.remove('hidden');

        var wrap = el('div', 'flex flex-col sm:flex-row items-center justify-between gap-3 text-xs sm:text-sm');
        wrap.appendChild(
          el(
            'div',
            'text-slate-600 tabular-nums',
            '共 ' + totalItems + ' ' + unitLabel + ' · 第 ' + currentPage + ' / ' + totalPages + ' 页（每页 ' + PAGE_SIZE + ' 条）'
          )
        );

        var controls = el('div', 'flex flex-wrap items-center gap-2');

        var prevBtn = el(
          'button',
          currentPage > 1
            ? 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors cursor-pointer'
            : 'px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-400 font-medium cursor-not-allowed',
          '上一页'
        );
        prevBtn.type = 'button';
        prevBtn.disabled = currentPage <= 1;
        prevBtn.addEventListener('click', function () {
          if (currentPage > 1) {
            currentPage--;
            renderCurrentPage(true);
          }
        });
        controls.appendChild(prevBtn);

        var nextBtn = el(
          'button',
          currentPage < totalPages
            ? 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors cursor-pointer'
            : 'px-3 py-1.5 rounded-lg border border-slate-100 bg-slate-50 text-slate-400 font-medium cursor-not-allowed',
          '下一页'
        );
        nextBtn.type = 'button';
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.addEventListener('click', function () {
          if (currentPage < totalPages) {
            currentPage++;
            renderCurrentPage(true);
          }
        });
        controls.appendChild(nextBtn);

        var jumpWrap = el('div', 'flex items-center gap-1.5 ml-1');
        jumpWrap.appendChild(el('span', 'text-slate-500 text-xs', '跳至'));
        var jumpInput = el(
          'input',
          'w-14 px-2 py-1 text-center bg-slate-50 border border-slate-200 rounded-md text-xs text-slate-800 tabular-nums focus:outline-none focus:border-teal-600'
        );
        jumpInput.type = 'number';
        jumpInput.min = '1';
        jumpInput.max = String(totalPages);
        jumpInput.value = String(currentPage);
        jumpInput.setAttribute('aria-label', '跳转页码');
        jumpWrap.appendChild(jumpInput);
        jumpWrap.appendChild(el('span', 'text-slate-500 text-xs', '页'));

        var jumpBtn = el(
          'button',
          'px-2.5 py-1 rounded-md bg-teal-700 hover:bg-teal-800 text-white text-xs font-medium transition-colors cursor-pointer',
          '跳转'
        );
        jumpBtn.type = 'button';
        function doJump() {
          var targetPage = parseInt(jumpInput.value, 10);
          if (!isNaN(targetPage)) {
            targetPage = Math.max(1, Math.min(totalPages, targetPage));
            if (targetPage !== currentPage) {
              currentPage = targetPage;
              renderCurrentPage(true);
            }
          }
        }
        jumpBtn.addEventListener('click', doJump);
        jumpInput.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter') {
            ev.preventDefault();
            doJump();
          }
        });
        jumpWrap.appendChild(jumpBtn);
        controls.appendChild(jumpWrap);

        wrap.appendChild(controls);
        paginationEl.appendChild(wrap);
      }

      function updateViewModeButtons() {
        if (!viewGroupedBtn || !viewJobsBtn) return;
        if (viewMode === 'grouped') {
          viewGroupedBtn.className = 'px-2.5 py-1 rounded-md bg-white text-slate-900 font-semibold shadow-2xs transition-colors cursor-pointer';
          viewJobsBtn.className = 'px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 font-medium transition-colors cursor-pointer';
        } else {
          viewJobsBtn.className = 'px-2.5 py-1 rounded-md bg-white text-slate-900 font-semibold shadow-2xs transition-colors cursor-pointer';
          viewGroupedBtn.className = 'px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 font-medium transition-colors cursor-pointer';
        }
      }

      function renderCurrentPage(scrollToTop) {
        listEl.replaceChildren();
        updateViewModeButtons();

        if (countEl) countEl.textContent = String(filteredCompanyGroups.length);
        if (jobCountEl) jobCountEl.textContent = String(filteredFlatJobs.length);

        if (viewMode === 'grouped') {
          var totalGroups = filteredCompanyGroups.length;
          var totalPages = Math.max(1, Math.ceil(totalGroups / PAGE_SIZE));
          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          var start = (currentPage - 1) * PAGE_SIZE;
          var pageGroups = filteredCompanyGroups.slice(start, start + PAGE_SIZE);
          var frag = document.createDocumentFragment();
          pageGroups.forEach(function (g) {
            frag.appendChild(renderCompanyGroupCard(g));
          });
          listEl.appendChild(frag);

          if (emptyFilterEl) {
            emptyFilterEl.classList.toggle('hidden', totalGroups > 0);
          }
          renderPagination(totalGroups, '家白名单企业');
        } else {
          var totalJobs = filteredFlatJobs.length;
          var totalJobPages = Math.max(1, Math.ceil(totalJobs / PAGE_SIZE));
          if (currentPage > totalJobPages) currentPage = totalJobPages;
          if (currentPage < 1) currentPage = 1;

          var jobStart = (currentPage - 1) * PAGE_SIZE;
          var pageJobs = filteredFlatJobs.slice(jobStart, jobStart + PAGE_SIZE);
          var jobFrag = document.createDocumentFragment();
          pageJobs.forEach(function (j) {
            jobFrag.appendChild(renderEnterpriseJobCard(j, true));
          });
          listEl.appendChild(jobFrag);

          if (emptyFilterEl) {
            emptyFilterEl.classList.toggle('hidden', totalJobs > 0);
          }
          renderPagination(totalJobs, '个在招岗位');
        }

        if (scrollToTop && listEl.getBoundingClientRect().top < 0) {
          listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function applyFiltersAndSort() {
        var q = (qInput && qInput.value ? qInput.value : '').trim().toLowerCase();
        var terms = q ? q.split(/\s+/).filter(Boolean) : [];
        var schedule = scheduleSelect ? scheduleSelect.value : '';
        var city = citySelect ? citySelect.value : '';
        var industry = industrySelect ? industrySelect.value : '';
        var benefit = benefitSelect ? benefitSelect.value : '';
        var onlyWithSalary = hasSalaryCheck ? hasSalaryCheck.checked : false;
        var sortMode = sortSelect ? sortSelect.value : 'salary_first';

        var nextGroups = [];
        var nextFlatJobs = [];

        allCompanies.forEach(function (company) {
          if (industry && company.industry !== industry) return;

          var compJobs = company._jobs || [];
          var compOwnMatchesTerms = terms.length === 0 || matchesTerms(company._ownSearch, terms);
          var compHasSchedule = !schedule || company.work_schedule === schedule;
          var compHasCity = !city || (company.cities || []).indexOf(city) !== -1;
          var compHasBenefit = !benefit || company._ownBenefits.indexOf(benefit) !== -1;

          var matchedJobs = compJobs.filter(function (job) {
            var em = job.enterprise_meta || {};
            if (onlyWithSalary && !jobHasSalary(job)) return false;
            if (city && job.city !== city) return false;
            var jSchedule = em.work_schedule || company.work_schedule;
            if (schedule && jSchedule !== schedule) return false;
            if (benefit) {
              var jb = job._benefitTags || [];
              if (jb.indexOf(benefit) === -1 && !compHasBenefit) return false;
            }
            if (terms.length > 0 && !matchesTerms(job._search, terms) && !compOwnMatchesTerms) {
              return false;
            }
            return true;
          });

          matchedJobs = sortJobsList(matchedJobs, sortMode);

          var companyMatched = false;
          if (onlyWithSalary) {
            companyMatched = matchedJobs.length > 0;
          } else if (compJobs.length > 0) {
            if (matchedJobs.length > 0) {
              companyMatched = true;
            } else if (compOwnMatchesTerms && compHasSchedule && compHasCity && compHasBenefit && terms.length > 0) {
              // Company metadata matched but specific jobs didn't; keep company visible
              companyMatched = true;
            }
          } else {
            companyMatched = compOwnMatchesTerms && compHasSchedule && compHasCity && compHasBenefit;
          }

          if (companyMatched) {
            var salaryJobCount = 0;
            var latestPub = '';
            matchedJobs.forEach(function (j) {
              if (jobHasSalary(j)) salaryJobCount++;
              if (j.published_at && j.published_at > latestPub) latestPub = j.published_at;
              nextFlatJobs.push(j);
            });
            nextGroups.push({
              company: company,
              matchedJobs: matchedJobs,
              salaryJobCount: salaryJobCount,
              latestPub: latestPub,
            });
          }
        });

        nextGroups.sort(function (a, b) {
          if (a.company.status !== b.company.status) {
            return a.company.status === 'active' ? -1 : 1;
          }
          if (sortMode === 'salary_first') {
            var aHasSal = a.salaryJobCount > 0 ? 1 : 0;
            var bHasSal = b.salaryJobCount > 0 ? 1 : 0;
            if (aHasSal !== bHasSal) return bHasSal - aHasSal;
            if (a.salaryJobCount !== b.salaryJobCount) return b.salaryJobCount - a.salaryJobCount;
            if (a.matchedJobs.length !== b.matchedJobs.length) return b.matchedJobs.length - a.matchedJobs.length;
          } else if (sortMode === 'job_count') {
            if (a.matchedJobs.length !== b.matchedJobs.length) return b.matchedJobs.length - a.matchedJobs.length;
            if (a.salaryJobCount !== b.salaryJobCount) return b.salaryJobCount - a.salaryJobCount;
          } else if (sortMode === 'published') {
            if (a.latestPub !== b.latestPub) return b.latestPub.localeCompare(a.latestPub);
          }
          return (a.company.name || '').localeCompare(b.company.name || '', 'zh-CN');
        });

        filteredCompanyGroups = nextGroups;
        filteredFlatJobs = sortJobsList(nextFlatJobs, sortMode);
        currentPage = 1;
        renderCurrentPage(false);
      }

      function resetAll() {
        if (qInput) qInput.value = '';
        if (scheduleSelect) scheduleSelect.value = '';
        if (citySelect) citySelect.value = '';
        if (industrySelect) industrySelect.value = '';
        if (benefitSelect) benefitSelect.value = '';
        if (hasSalaryCheck) hasSalaryCheck.checked = false;
        if (sortSelect) sortSelect.value = 'salary_first';
        companyVisibleLimitMap = {};
        applyFiltersAndSort();
      }

      try {
        var params = new URLSearchParams(window.location.search);
        var initQ = params.get('q');
        var initCity = params.get('city');
        var initSchedule = params.get('schedule');
        var initSalary = params.get('salary');
        var initView = params.get('view');
        if (initQ && qInput) qInput.value = initQ;
        if (initCity && citySelect) citySelect.value = initCity;
        if (initSchedule && scheduleSelect) scheduleSelect.value = initSchedule;
        if (initSalary === '1' && hasSalaryCheck) hasSalaryCheck.checked = true;
        if (initView === 'jobs') viewMode = 'jobs';
      } catch (e) {}

      [
        qInput,
        scheduleSelect,
        citySelect,
        industrySelect,
        benefitSelect,
        hasSalaryCheck,
        sortSelect,
      ].forEach(function (ctrl) {
        if (!ctrl) return;
        ctrl.addEventListener('input', applyFiltersAndSort);
        ctrl.addEventListener('change', applyFiltersAndSort);
      });

      if (viewGroupedBtn) {
        viewGroupedBtn.addEventListener('click', function () {
          if (viewMode !== 'grouped') {
            viewMode = 'grouped';
            currentPage = 1;
            renderCurrentPage(false);
          }
        });
      }
      if (viewJobsBtn) {
        viewJobsBtn.addEventListener('click', function () {
          if (viewMode !== 'jobs') {
            viewMode = 'jobs';
            currentPage = 1;
            renderCurrentPage(false);
          }
        });
      }

      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

      fetch('/api/jobs.json')
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (payload) {
          if (loadingEl) loadingEl.classList.add('hidden');
          allCompanies = Array.isArray(payload.companies) ? payload.companies : [];
          allEnterpriseJobs = Array.isArray(payload.enterprise_jobs) ? payload.enterprise_jobs : [];

          companyById = {};
          allCompanies.forEach(function (c) {
            c._jobs = [];
            c._ownBenefits = (c.benefit_claims || []).map(function (b) {
              return b.label;
            });
            c._ownSearch = buildCompanyOwnSearchText(c);
            companyById[c.company_id] = c;
          });

          var orphanByOrg = {};
          allEnterpriseJobs.forEach(function (job) {
            var em = job.enterprise_meta || {};
            var cid = em.company_id;
            var parentComp = cid ? companyById[cid] : null;
            job._benefitTags = (em.benefits_verified || []).map(function (b) {
              return b.tag;
            });
            job._search = buildJobSearchText(job, parentComp ? parentComp.name : job.org_name);
            if (parentComp) {
              parentComp._jobs.push(job);
            } else {
              var fallbackId = cid || ('orphan-' + (job.org_name || 'unknown'));
              if (!orphanByOrg[fallbackId]) {
                var fallbackComp = {
                  company_id: fallbackId,
                  name: job.org_name || '其他已核验企业',
                  aliases: [],
                  industry: em.department || '综合行业',
                  cities: job.city ? [job.city] : [],
                  career_url: job.source_url,
                  saas_platform: 'unknown',
                  work_schedule: em.work_schedule || '其他',
                  benefit_claims: (em.benefits_verified || []).map(function (b) {
                    return {
                      label: b.tag,
                      evidence_quote: b.evidence_quote,
                      evidence_url: b.evidence_url || job.source_url,
                      verified_at: job.published_at || '',
                    };
                  }),
                  status: 'active',
                  notes: null,
                  _jobs: [],
                };
                fallbackComp._ownBenefits = fallbackComp.benefit_claims.map(function (b) {
                  return b.label;
                });
                fallbackComp._ownSearch = buildCompanyOwnSearchText(fallbackComp);
                orphanByOrg[fallbackId] = fallbackComp;
                allCompanies.push(fallbackComp);
                companyById[fallbackId] = fallbackComp;
              }
              orphanByOrg[fallbackId]._jobs.push(job);
            }
          });

          applyFiltersAndSort();
        })
        .catch(function () {
          if (loadingEl) {
            loadingEl.textContent = '加载静态数据索引失败，请刷新页面重试。';
          }
        });
    })();
  </script>
</BaseLayout>
