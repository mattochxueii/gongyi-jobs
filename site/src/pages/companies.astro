---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  hasExplicitSalary,
  loadSiteData,
} from '../lib/data';
import type { CompanyWorkSchedule } from '../lib/types';

const data = loadSiteData();
const companies = data.companies;
const enterpriseJobs = data.jobs.filter((j) => j.category === 'enterprise');
const explicitSalaryJobsCount = enterpriseJobs.filter(hasExplicitSalary).length;

const SCHEDULE_OPTIONS: CompanyWorkSchedule[] = [
  '周末双休',
  '弹性工作',
  '做四休三',
  '其他',
];

const citySet = new Set<string>();
const industrySet = new Set<string>();
const benefitSet = new Set<string>();

for (const c of companies) {
  for (const city of c.cities ?? []) {
    if (city) citySet.add(city);
  }
  if (c.industry) industrySet.add(c.industry);
  for (const claim of c.benefit_claims ?? []) {
    if (claim.label) benefitSet.add(claim.label);
  }
}

for (const job of enterpriseJobs) {
  if (job.city) citySet.add(job.city);
  for (const b of job.enterprise_meta?.benefits_verified ?? []) {
    if (b.tag) benefitSet.add(b.tag);
  }
}

const availableCities = Array.from(citySet).sort((a, b) => a.localeCompare(b, 'zh-CN'));
const availableIndustries = Array.from(industrySet).sort((a, b) => a.localeCompare(b, 'zh-CN'));
const availableBenefits = Array.from(benefitSet).sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout
  title="高福利民营企业白名单专区 · 豫聘公益导航"
  description="高福利民营企业白名单与在招岗位展示：显性标注岗位薪资范围或官网面议状态，支持「仅看已标明薪资」过滤与「有明确薪资优先」排序，支持休假制度、城市、行业与福利标签筛选，每条福利标签均附官网原文引用与溯源链接。"
  activeNav="companies"
  isPreviewFixtures={data.isPreviewFixtures}
  latestUpdatedAt={data.latestUpdatedAt}
>
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 sm:py-9">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-sky-50 text-sky-800 border border-sky-200 text-xs font-medium mb-2">
            正向客观收录 · 薪资透明化展示 · 每项福利均附官网原文证据
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            高福利民企白名单专区
          </h1>
          <p class="mt-1.5 text-sm text-slate-600">
            绝不发布无依据传言或情绪化黑名单 · 每张岗位卡显性展示官网薪资或面议状态，点击福利旁「原文溯源」可直达官方核实。
          </p>
        </div>
        <div class="text-xs sm:text-sm text-slate-600 bg-slate-50 px-3.5 py-2 rounded-lg border border-slate-200 tabular-nums shrink-0">
          白名单企业 <strong id="comp-header-total" class="text-slate-900">{companies.length}</strong> 家 · 在招岗位 <strong id="comp-header-jobs-total" class="text-slate-900">{enterpriseJobs.length}</strong> 个（明码标薪 <strong id="comp-header-salary-total" class="text-amber-900">{explicitSalaryJobsCount}</strong> 个）
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 space-y-6">
    <section
      aria-label="民企白名单多维筛选"
      class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-xs space-y-4"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="sm:col-span-2 lg:col-span-1">
          <label for="comp-filter-q" class="block text-xs font-medium text-slate-600 mb-1">
            关键字搜索
          </label>
          <input
            id="comp-filter-q"
            type="search"
            placeholder="企业名、岗位、薪资、福利原文..."
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          />
        </div>

        <div>
          <label for="comp-filter-schedule" class="block text-xs font-medium text-slate-600 mb-1">
            休假制度
          </label>
          <select
            id="comp-filter-schedule"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部休假制度</option>
            {SCHEDULE_OPTIONS.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div>
          <label for="comp-filter-city" class="block text-xs font-medium text-slate-600 mb-1">
            办公城市
          </label>
          <select
            id="comp-filter-city"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部城市</option>
            {availableCities.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <div>
          <label for="comp-filter-industry" class="block text-xs font-medium text-slate-600 mb-1">
            所属行业
          </label>
          <select
            id="comp-filter-industry"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部行业</option>
            {availableIndustries.map((ind) => <option value={ind}>{ind}</option>)}
          </select>
        </div>

        <div>
          <label for="comp-filter-benefit" class="block text-xs font-medium text-slate-600 mb-1">
            已核验福利标签
          </label>
          <select
            id="comp-filter-benefit"
            class="w-full px-3 py-2 bg-slate-50 focus:bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
          >
            <option value="">全部福利标签</option>
            {availableBenefits.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pt-2.5 border-t border-slate-100">
        <div class="flex flex-wrap items-center gap-3">
          <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50/90 border border-amber-200 text-xs sm:text-sm font-semibold text-amber-950 cursor-pointer select-none">
            <input
              id="comp-filter-has-salary"
              type="checkbox"
              class="rounded border-amber-400 text-amber-700 focus:ring-amber-600"
            />
            <span>💰 仅看已标明薪资</span>
          </label>

          <div class="flex items-center gap-2">
            <label for="comp-filter-sort" class="text-xs font-medium text-slate-600 shrink-0">
              排序：
            </label>
            <select
              id="comp-filter-sort"
              class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600/20 focus:border-teal-600"
            >
              <option value="salary_first" selected>有明确薪资优先</option>
              <option value="job_count">在招岗位数量优先</option>
              <option value="published">最新发布优先</option>
              <option value="name">按企业名称排序</option>
            </select>
          </div>

          <div class="inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-xs">
            <button
              id="comp-view-grouped"
              type="button"
              class="px-2.5 py-1 rounded-md bg-white text-slate-900 font-semibold shadow-2xs transition-colors cursor-pointer"
            >
              按企业分组展开
            </button>
            <button
              id="comp-view-jobs"
              type="button"
              class="px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 font-medium transition-colors cursor-pointer"
            >
              按岗位分页 (20条/页)
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between lg:justify-end gap-3 text-xs sm:text-sm">
          <div class="text-slate-600 tabular-nums">
            匹配企业：<strong id="comp-match-count" class="text-slate-900">{companies.length}</strong> 家
            <span class="mx-1.5 text-slate-300">|</span>
            在招岗位：<strong id="comp-job-match-count" class="text-slate-900">{enterpriseJobs.length}</strong> 个
          </div>
          <button
            id="comp-reset-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 text-xs font-medium transition-colors cursor-pointer"
          >
            重置筛选
          </button>
        </div>
      </div>
    </section>

    {
      companies.length === 0 && enterpriseJobs.length === 0 ? (
        <section
          id="companies-init-empty"
          class="bg-white rounded-xl border border-slate-200 p-8 sm:p-12 text-center space-y-3"
        >
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-500 mx-auto">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-slate-900">
            数据初始化中 · 暂无高福利民企白名单记录
          </h2>
          <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
            当前 <code class="px-1 py-0.5 rounded bg-slate-100 text-xs">data/companies.json</code> 暂为空数组。所有拟入库企业均需经官网招聘原文引用与来源链接双重核验。如果您了解符合双休或高福利标准的企业，欢迎前往公益说明页提交推荐线索。
          </p>
          <div class="pt-2 flex flex-wrap justify-center gap-3">
            <a
              href="/about"
              class="px-4 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-sm font-medium transition-colors"
            >
              推荐好企业 / 提交纠错
            </a>
            <a
              href="/public"
              class="px-4 py-2 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium transition-colors"
            >
              浏览事业编专区
            </a>
          </div>
        </section>
      ) : (
        <>
          <div
            id="companies-loading-state"
            class="bg-white rounded-xl border border-slate-200 p-8 text-center text-sm text-slate-500"
          >
            正在加载高福利民企白名单与在招岗位静态索引（共 {companies.length} 家企业、{enterpriseJobs.length} 个在招岗位）…
          </div>

          <div id="companies-list" class="space-y-6"></div>

          <nav
            id="companies-pagination"
            aria-label="高福利民企与岗位分页导航"
            class="hidden bg-white rounded-xl border border-slate-200 p-4 shadow-xs"
          ></nav>

          <section
            id="companies-empty-filter"
            class="hidden bg-white rounded-xl border border-slate-200 p-8 sm:p-10 text-center space-y-3"
          >
            <h2 class="text-base sm:text-lg font-semibold text-slate-900">
              暂无匹配的白名单企业或岗位
            </h2>
            <p class="text-sm text-slate-600">
              当前筛选条件下没有找到符合要求的企业、薪资条件或福利标签，可尝试取消「仅看已标明薪资」或放宽休假制度、城市与关键字限制。
            </p>
            <div>
              <button
                id="comp-empty-reset-btn"
                type="button"
                class="px-4 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-sm font-medium transition-colors cursor-pointer"
              >
                清空所有筛选条件
              </button>
            </div>
          </section>
        </>
      )
    }
  </div>

  <script is:inline>
    (function () {
      var listEl = document.getElementById('companies-list');
      if (!listEl) return;

      var PAGE_SIZE = 20;
      var PREVIEW_JOBS_PER_COMPANY = 3;
      var UNKNOWN_SALARY_LABEL = '薪资：官网未公开 / 面议';
      var UNKNOWN_SALARY_TOOLTIP = '企业官网未披露具体数额，可点官网详情核实';

      var SAAS_PLATFORM_LABELS = {
        moka: 'Moka 招聘',
        beisen: '北森招聘',
        feishu: '飞书招聘',
        greenhouse: 'Greenhouse',
        lever: 'Lever',
        workday: 'Workday',
        custom: '企业自建官网',
        unknown: '官方通道',
      };

      var SOURCE_TYPE_LABELS = {
        gov_official: '政务官网',
        institution_official: '事业单位官网',
        company_official: '企业官网',
        verified_saas: '官方招聘SaaS',
      };

      var loadingEl = document.getElementById('companies-loading-state');
      var paginationEl = document.getElementById('companies-pagination');
      var emptyFilterEl = document.getElementById('companies-empty-filter');
      var countEl = document.getElementById('comp-match-count');
      var jobCountEl = document.getElementById('comp-job-match-count');

      var qInput = document.getElementById('comp-filter-q');
      var scheduleSelect = document.getElementById('comp-filter-schedule');
      var citySelect = document.getElementById('comp-filter-city');
      var industrySelect = document.getElementById('comp-filter-industry');
      var benefitSelect = document.getElementById('comp-filter-benefit');
      var hasSalaryCheck = document.getElementById('comp-filter-has-salary');
      var sortSelect = document.getElementById('comp-filter-sort');
      var viewGroupedBtn = document.getElementById('comp-view-grouped');
      var viewJobsBtn = document.getElementById('comp-view-jobs');
      var resetBtn = document.getElementById('comp-reset-btn');
      var emptyResetBtn = document.getElementById('comp-empty-reset-btn');

      var allCompanies = [];
      var allEnterpriseJobs = [];
      var companyById = {};
      var viewMode = 'grouped'; // 'grouped' | 'jobs'
      var currentPage = 1;

      // Track per-company expand state and in-company page limit: { [company_id]: numberOfVisibleJobs }
      var companyVisibleLimitMap = {};

      var filteredCompanyGroups = [];
      var filteredFlatJobs = [];

      var beijingToday = new Date(Date.now() + 8 * 3600000).toISOString().slice(0, 10);
      var todayParts = beijingToday.split('-').map(Number);
      var todayUtc = Date.UTC(todayParts[0], todayParts[1] - 1, todayParts[2]);

      function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined && text !== null) node.textContent = String(text);
        return node;
      }

      function safeHttpUrl(rawUrl) {
        if (!rawUrl || typeof rawUrl !== 'string') return null;
        var trimmed = rawUrl.trim();
        try {
          var parsed = new URL(trimmed, window.location.origin);
          if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
            return parsed.href;
          }
        } catch (e) {}
        return null;
      }

      function jobHasSalary(job) {
        var em = job.enterprise_meta;
        return Boolean(em && typeof em.salary_range === 'string' && em.salary_range.trim().length > 0);
      }

      function formatSalaryText(rawSalary) {
        var s = rawSalary.trim();
        return s.indexOf('💰') === 0 ? s : '💰 ' + s;
      }

      function createSalaryBadge(job) {
        if (jobHasSalary(job)) {
          return el(
            'span',
            'inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-amber-100 text-amber-950 border border-amber-300 text-xs sm:text-sm font-bold tabular-nums shadow-2xs',
            formatSalaryText(job.enterprise_meta.salary_range)
          );
        }
        var grayBadge = el(
          'span',
          'inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 border border-slate-200 text-xs font-medium cursor-help',
          UNKNOWN_SALARY_LABEL
        );
        grayBadge.setAttribute('title', UNKNOWN_SALARY_TOOLTIP);
        return grayBadge;
      }

      function computeDeadlineLabel(deadlineAt, status) {
        if (status === 'expired' || status === 'closed') {
          return status === 'closed' ? '已关闭' : '已截止';
        }
        if (!deadlineAt || !/^\d{4}-\d{2}-\d{2}$/.test(deadlineAt)) return null;
        var p = deadlineAt.split('-').map(Number);
        var diff = Math.round((Date.UTC(p[0], p[1] - 1, p[2]) - todayUtc) / 86400000);
        if (diff < 0) return '已截止';
        if (diff === 0) return '今日截止';
        return '剩 ' + diff + ' 天';
      }

      function buildJobSearchText(job, companyName) {
        var em = job.enterprise_meta || {};
        var parts = [
          companyName || job.org_name || '',
          job.title || '',
          job.city || '',
          job.district || '',
          job.summary || '',
          (job.tags || []).join(' '),
          em.department || '',
          em.work_schedule || '',
          em.work_hours || '',
          em.remote_policy || '',
          em.salary_range || '',
          em.experience_req || '',
          em.education_req || '',
        ];
        var bvs = Array.isArray(em.benefits_verified) ? em.benefits_verified : [];
        for (var i = 0; i < bvs.length; i++) {
          parts.push(bvs[i].tag || '', bvs[i].evidence_quote || '');
        }
        return parts.join(' ').toLowerCase();
      }

      function buildCompanyOwnSearchText(company) {
        var parts = [
          company.name || '',
          (company.aliases || []).join(' '),
          company.industry || '',
          (company.cities || []).join(' '),
          company.work_schedule || '',
          company.notes || '',
        ];
        var claims = Array.isArray(company.benefit_claims) ? company.benefit_claims : [];
        for (var i = 0; i < claims.length; i++) {
          parts.push(claims[i].label || '', claims[i].evidence_quote || '');
        }
        return parts.join(' ').toLowerCase();
      }

      function matchesTerms(hay, terms) {
        for (var i = 0; i < terms.length; i++) {
          if (hay.indexOf(terms[i]) === -1) return false;
        }
        return true;
      }

      function sortJobsList(jobs, sortMode) {
        return jobs.slice().sort(function (a, b) {
          var aSal = jobHasSalary(a) ? 1 : 0;
          var bSal = jobHasSalary(b) ? 1 : 0;
          if (sortMode === 'salary_first' && aSal !== bSal) {
            return bSal - aSal;
          }
          if (sortMode === 'published') {
            var pa = a.published_at || '';
            var pb = b.published_at || '';
            if (pa !== pb) return pb.localeCompare(pa);
          }
          if (aSal !== bSal) return bSal - aSal;
          var pubA = a.published_at || '';
          var pubB = b.published_at || '';
          if (pubA !== pubB) return pubB.localeCompare(pubA);
          return (a.title || '').localeCompare(b.title || '', 'zh-CN');
        });
      }

      function renderEnterpriseJobCard(job, showCompanyHeader) {
        var em = job.enterprise_meta || {};
        var company = companyById[em.company_id] || null;
        var card = el('div', 'rounded-lg bg-slate-50/80 border border-slate-200 p-4 space-y-3 hover:border-slate-300 transition-colors');

        var topRow = el('div', 'flex flex-col sm:flex-row sm:items-start justify-between gap-2.5');
        var leftDiv = el('div', 'space-y-1.5 min-w-0');

        var badgeRow = el('div', 'flex flex-wrap items-center gap-1.5 text-xs');
        if (showCompanyHeader) {
          badgeRow.appendChild(
            el('span', 'px-2 py-0.5 rounded bg-teal-50 border border-teal-200 text-teal-900 font-semibold', job.org_name)
          );
        }
        var locText = job.city + (job.district ? ' · ' + job.district : '');
        badgeRow.appendChild(
          el('span', 'px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700 font-medium', locText)
        );
        if (em.work_schedule) {
          badgeRow.appendChild(
            el('span', 'px-2 py-0.5 rounded bg-sky-50 border border-sky-200 text-sky-800 font-medium', em.work_schedule)
          );
        }
        if (em.remote_policy) {
          badgeRow.appendChild(
            el('span', 'px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600', em.remote_policy)
          );
        }
        leftDiv.appendChild(badgeRow);

        leftDiv.appendChild(el('h4', 'text-base font-bold text-slate-900 leading-snug', job.title));

        var metaInfo = el('div', 'flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-slate-500');
        if (em.department) metaInfo.appendChild(el('span', '', '部门：' + em.department));
        if (em.experience_req) metaInfo.appendChild(el('span', '', '经验：' + em.experience_req));
        if (em.education_req) metaInfo.appendChild(el('span', '', '学历：' + em.education_req));
        if (em.work_hours) metaInfo.appendChild(el('span', '', '工时：' + em.work_hours));
        if (job.published_at) metaInfo.appendChild(el('span', 'tabular-nums', '发布：' + job.published_at));
        if (metaInfo.childNodes.length > 0) {
          leftDiv.appendChild(metaInfo);
        }
        topRow.appendChild(leftDiv);

        // Right column: Prominent Salary Badge + Deadline/Source
        var rightDiv = el('div', 'flex flex-wrap sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0');
        rightDiv.appendChild(createSalaryBadge(job));

        var subRight = el('div', 'flex flex-wrap items-center gap-2');
        var dlLabel = computeDeadlineLabel(job.deadline_at, job.status);
        if (job.deadline_at && dlLabel) {
          subRight.appendChild(
            el(
              'span',
