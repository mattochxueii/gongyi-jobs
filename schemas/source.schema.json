{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongyi-jobs.local/schemas/source.schema.json",
  "title": "SourceRegistry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "name",
          "category",
          "province",
          "adapter",
          "base_url",
          "enabled",
          "url_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,78}[a-z0-9]$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category": { "type": "string", "enum": ["public_institution", "enterprise"] },
          "province": { "type": "string", "minLength": 1, "maxLength": 40 },
          "city": { "type": ["string", "null"], "maxLength": 60 },
          "adapter": { "type": "string", "minLength": 1, "maxLength": 60 },
          "base_url": { "type": "string", "format": "uri" },
          "list_urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "enabled": { "type": "boolean" },
          "url_verified": { "type": "boolean" },
          "fetch_interval_hours": { "type": "integer", "minimum": 1, "maximum": 720 },
          "notes": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    }
  }
}
