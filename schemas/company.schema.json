{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongyi-jobs.local/schemas/company.schema.json",
  "title": "CompanyWhitelistDataset",
  "type": "object",
  "required": ["schema_version", "updated_at", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company_id",
          "name",
          "industry",
          "cities",
          "career_url",
          "saas_platform",
          "work_schedule",
          "benefit_claims",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "company_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "industry": { "type": "string", "minLength": 1, "maxLength": 60 },
          "cities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "career_url": { "type": "string", "format": "uri" },
          "saas_platform": {
            "type": "string",
            "enum": ["moka", "beisen", "feishu", "greenhouse", "lever", "workday", "custom", "unknown"]
          },
          "work_schedule": {
            "type": "string",
            "enum": ["周末双休", "弹性工作", "做四休三", "其他"]
          },
          "benefit_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "evidence_quote", "evidence_url", "verified_at"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 50 },
                "evidence_quote": { "type": "string", "minLength": 2, "maxLength": 300 },
                "evidence_url": { "type": "string", "format": "uri" },
                "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "status": { "type": "string", "enum": ["active", "paused"] },
          "notes": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    }
  }
}
